[configuration]
entry_symbol = "core_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libcore.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libcore.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libcore.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libcore.windows.template_release.x86_64.dll"
macos.debug = "res://bin/libcore.macos.template_debug.framework"
macos.release = "res://bin/libcore.macos.template_release.framework"
